#include <windows.h>

// Application icon (shell, taskbar, Alt-Tab). Must be the first icon resource so the
// Windows shell picks it as the executable's icon.
IDI_ICON1 ICON "resources/icons/tweaker.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,9,3,0
PRODUCTVERSION  0,9,3,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Arbitrium"
            VALUE "FileDescription",  "Windows Tweaker"
            VALUE "FileVersion",      "0.9.3"
            VALUE "InternalName",     "Arbitrium"
            VALUE "OriginalFilename", "Arbitrium.exe"
            VALUE "ProductName",      "Arbitrium"
            VALUE "ProductVersion",   "0.9.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
