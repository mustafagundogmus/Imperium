#include <windows.h>

// Application icon (shell, taskbar, Alt-Tab). Must be the first icon resource so the
// Windows shell picks it as the executable's icon.
IDI_ICON1 ICON "resources/icons/tweaker.ico"

// The elevation request. Listing the manifest as a CMake source is enough to stop Qt
// generating its asInvoker one, but not enough to embed ours: that path is MSVC-only, and
// this is a MinGW build. windres puts it where Windows actually looks — resource 1 of
// type RT_MANIFEST, read before the process is created.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "resources/Arbitrium.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,9,10,0
PRODUCTVERSION  0,9,10,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Arbitrium"
            // Task Manager's "Name" column shows this, not ProductName.
            VALUE "FileDescription",  "Arbitrium"
            VALUE "FileVersion",      "0.9.10"
            VALUE "InternalName",     "Arbitrium"
            VALUE "OriginalFilename", "Arbitrium.exe"
            VALUE "ProductName",      "Arbitrium"
            VALUE "ProductVersion",   "0.9.10"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
